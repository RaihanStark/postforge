{
  "name": "postforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An AI studio for forging on-brand social media posts across every platform at once.",
  "author": "RaihanStark <dev@byraihan.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "setup": "npm install && npm --prefix web install",
    "build:web": "npm --prefix web run build",
    "electron": "electron .",
    "test": "node --test",
    "dist": "npm run build:web && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.byraihan.postforge",
    "productName": "PostForge",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "RaihanStark",
      "repo": "postforge"
    },
    "files": [
      "**/*",
      "!web/node_modules",
      "!web/src",
      "!web/public",
      "!web/index.html",
      "!web/vite.config.js",
      "!web/package*.json",
      "!docs",
      "!.github",
      "!**/*.md",
      "!scratchpad"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "RaihanStark <dev@byraihan.com>",
      "synopsis": "Forge on-brand social posts with Claude"
    }
  }
}
